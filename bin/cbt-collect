#!/usr/bin/env perl
# CBT: collect configuration from base stations listed in an inventory.
#
#   bin/cbt-collect -i conf/devices.local.conf            # all devices
#   bin/cbt-collect -i conf/devices.local.conf -d TKY-ENB-0001
#   bin/cbt-collect -i conf/devices.local-ssh.conf -v    # SSH lab, show each step
#
# Each device is collected over its inventory 'protocol' (telnet | ssh).
# Relative key_file / known_hosts paths are taken from the repository root.
#
# Output: OUTDIR/<device>/<device>_<YYYYmmdd-HHMMSS>.cfg and OUTDIR/<device>/latest.cfg
use strict;
use warnings;
use FindBin;
use lib "$FindBin::RealBin/../lib";
use Getopt::Long;
use File::Path qw(make_path);
use File::Copy qw(copy);
use POSIX qw(strftime);
use Cwd ();
use IPC::Open3 qw(open3);
use Symbol qw(gensym);
use CBT::Inventory;

$| = 1;
my $ROOT = Cwd::abs_path("$FindBin::RealBin/..");

# Which collector handles which model / software version.
my %HANDLERS = (
    'AX-4000:R5' => { module => 'CBT::Collector::AX4000_R5' },
    'AX-4000:R6' => { module => 'CBT::Collector::AX4000_R6' },
    'BG-7:V200'  => { script => "$ROOT/collectors/bg7_v200.pl" },
);

my %o = ( inventory => "$ROOT/conf/devices.conf", outdir => "$ROOT/output", logdir => "$ROOT/log", timeout => 20 );
GetOptions( \%o, 'inventory|i=s', 'device|d=s@', 'outdir|o=s', 'logdir=s', 'timeout=i', 'verbose|v', 'help|h' )
  or usage();
usage() if $o{help};

my $devices = CBT::Inventory->load( $o{inventory} );
if ( $o{device} ) {
    my %want = map { $_ => 1 } @{ $o{device} };
    $devices = [ grep { $want{ $_->{name} } } @$devices ];
    die "no matching devices in $o{inventory}\n" unless @$devices;
}

make_path( $o{outdir}, $o{logdir} );
my $ts = strftime( '%Y%m%d-%H%M%S', localtime );
my @failed;

for my $dev (@$devices) {
    my $key     = "$dev->{model}:" . ( $dev->{sw} =~ /^([A-Z]+\d+)/ ? $1 : $dev->{sw} );
    my $handler = $HANDLERS{$key};
    my $dir     = "$o{outdir}/$dev->{name}";
    my $file    = "$dir/$dev->{name}_$ts.cfg";
    my $log     = "$o{logdir}/$dev->{name}.session.log";
    make_path($dir);
    for my $k (qw(key_file known_hosts)) {
        $dev->{$k} = "$ROOT/$dev->{$k}" if defined $dev->{$k} && length $dev->{$k} && $dev->{$k} !~ m{^/};
    }
    my $via = $dev->{protocol} eq 'ssh' ? "ssh/$dev->{auth}" : 'telnet';
    printf "%-14s %-8s %-12s %-12s %s:%s ... %s", $dev->{name}, $dev->{model}, $dev->{sw}, $via, $dev->{host}, $dev->{port},
      $o{verbose} ? "\n" : '';
    my $step = $o{verbose} ? sub { local $| = 1; printf "    > %s\n", shift } : undef;

    my $ok = eval {
        die "no collector for $key\n" unless $handler;
        if ( $handler->{module} ) {
            eval "require $handler->{module}; 1" or die $@;
            my $c = $handler->{module}->new( timeout => $o{timeout}, session_log => $log, progress => $step );
            my $sections = $c->collect($dev);
            open my $out, '>', $file or die "cannot write $file: $!\n";
            print $out "!! ===== $_->[0] =====\n", $_->[1] for @$sections;
            close $out;
        }
        else {
            run_script( $handler->{script}, $dev, $file, $log );
        }
        1;
    };
    if ($ok) {
        my $header = "!! CBT collected $dev->{name} ($dev->{model} $dev->{sw}) at $ts\n";
        prepend( $file, $header );
        copy( $file, "$dir/latest.cfg" );
        my $lines = () = do { open my $fh, '<', $file; <$fh> };
        print $o{verbose} ? '    => ' : '', "OK ($lines lines) -> $file\n";
    }
    else {
        my $err = $@ || "unknown error\n";
        print $o{verbose} ? '    => ' : '', "FAILED: $err";
        unlink $file;
        push @failed, $dev->{name};
    }
}

printf "\n%d/%d devices collected\n", @$devices - @failed, scalar @$devices;
exit( @failed ? 1 : 0 );

# Standalone collector scripts get the transport settings as options; secrets
# go through the child's environment, not its (world-readable) command line.
sub run_script {
    my ( $script, $dev, $file, $log ) = @_;
    my @opt = ( '--protocol', $dev->{protocol}, '--timeout', $o{timeout}, '--log', $log, $o{verbose} ? '--verbose' : () );
    if ( $dev->{protocol} eq 'ssh' ) {
        push @opt, '--auth', $dev->{auth}, '--host-key-check', $dev->{host_key_check};
        push @opt, '--key-file',    $dev->{key_file}    if $dev->{auth} eq 'key';
        push @opt, '--known-hosts', $dev->{known_hosts} if $dev->{known_hosts};
    }
    local $ENV{CBT_SESSION_PASSWORD}       = $dev->{password}       // '';
    local $ENV{CBT_SESSION_KEY_PASSPHRASE} = $dev->{key_passphrase} // '';
    my $pid = open3( my $in, '>&STDOUT', my $err = gensym, $^X, $script, @opt,
        $dev->{host}, $dev->{port}, $dev->{user} // '', '-', $file );
    close $in;
    my @err = <$err>;
    waitpid $pid, 0;
    return 1 if $? == 0;
    die $err[-1] if @err;
    die "collector script exited with status " . ( $? >> 8 ) . "\n";
}

sub prepend {
    my ( $file, $text ) = @_;
    open my $in, '<', $file or die "$file: $!";
    local $/;
    my $body = <$in>;
    close $in;
    open my $out, '>', $file or die "$file: $!";
    print $out $text, $body;
    close $out;
}

sub usage {
    print <<"END";
usage: $0 [-i INVENTORY] [-d DEVICE ...] [-o OUTDIR] [--logdir DIR] [--timeout SEC] [-v]
END
    exit 2;
}
